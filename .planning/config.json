{
  "model_profile": "inherit",
  "runtime": "cursor",
  "resolve_model_ids": "omit",
  "models": {
    "planning": "inherit",
    "discuss": "inherit",
    "research": "haiku",
    "execution": "sonnet",
    "verification": "sonnet"
  },
  "model_profile_overrides": {
    "cursor": {
      "haiku": "composer-2.5-fast",
      "sonnet": "composer-2.5-fast",
      "opus": "inherit"
    }
  },
  "model_overrides": {
    "gsd-debugger": "inherit",
    "gsd-planner": "inherit"
  },
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": true,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": true,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "_auto_chain_active": false,
    "milestone_assessment": {
      "verify_lib_before_scope": true,
      "adopter_lens_default": true,
      "stop_milestone_includes_release_truth": true,
      "jtbd_refresh_at_milestone_close": true,
      "docs_truth_prose_surfaces": [
        "guides/getting-started.md"
      ],
      "docs_truth_canonical_guides": [
        "guides/payments.md"
      ],
      "verify_untracked_proof_files": true
    }
  },
  "hooks": {
    "context_warnings": true
  },
  "agent_skills": {},
  "mode": "yolo",
  "granularity": "fine"
}
